# xboard-one-click local config example
# 复制为 deploy.env 后修改，再执行 bash install.sh

# 建议保留 80/443 给 NPM，后续申请证书更方便
NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443

# 这两个更建议按你的习惯自定义
NPM_ADMIN_PORT=20881
XBOARD_PORT=27001

XBOARD_ADMIN_EMAIL=admin@example.com
# 仅全新安装会生成密码；修复不会重置。菜单 22 可验证展示或单独重置。
XBOARD_ADMIN_PASSWORD=
XBOARD_REPO=https://github.com/cedar2025/Xboard
XBOARD_BRANCH=compose
ENABLE_FIREWALL_OPEN=1
FORCE_XBOARD_INSTALL=0
# 已有数据库时禁止 FORCE_XBOARD_INSTALL=1。
AUTO_RELEASE_NPM_PORTS=1
PRE_UPDATE_BACKUP=0
# 旧兼容字段，不再决定更新方式；仅 update.sh --with-backup 明确启用更新前备份。
AUTO_ROLLBACK_ON_UPDATE_FAIL=1
